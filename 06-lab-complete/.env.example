# Biến môi trường của agent — copy thành .env rồi điền (file .env nằm trong .gitignore)
#   cp .env.example .env
# KHÔNG ghi secret thật vào file này.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt một chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis (rate limit + cost guard). Trong docker compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
